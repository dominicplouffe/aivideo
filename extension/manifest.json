{
  "manifest_version": 3,
  "name": "DemoRiff Capture",
  "version": "0.1.0",
  "description": "Record a tab, and the interactions inside it, as the raw material for a studio-grade product demo.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DemoRiff Capture",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/capture.js",
        "dist/main-world.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
