# DemoRiff production settings. `scripts/lightsail.sh init` copies this to
# deploy/.env.production (git-ignored) and fills in the generated secrets.
# Keep that file safe: DEMORIFF_SECRET_KEY encrypts stored vendor keys and
# sign-ins, and losing it makes them unreadable.

NEXT_PUBLIC_SITE_URL=https://demoriff.com
# Fail loudly at start-up if a vendor key is missing, rather than quietly
# using mock transcription or voices.
DEMORIFF_PROVIDERS=live

# --- generated by init ---------------------------------------------------
POSTGRES_PASSWORD=
DATABASE_URL=
DEMORIFF_SECRET_KEY=
DEMORIFF_SESSION_SECRET=
DEMORIFF_LINK_SECRET=
DEMORIFF_WEBHOOK_SECRET=
DEMORIFF_SSO_STATE_SECRET=
STORAGE_SIGNING_SECRET=

# --- vendors (init copies these from .env.local when present) ------------
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# --- sign-in: required, email-only sign-in is off in production -------------
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Who sees /app/admin and can grant any workspace a plan without paying.
DEMORIFF_STAFF_EMAILS=

# --- payments (live mode) ---------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BYOK=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_STUDIO_PACK=

# Where Let's Encrypt sends certificate expiry notices.
ACME_EMAIL=
