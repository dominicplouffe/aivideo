# ---------------------------------------------------------------------------
# DemoRiff — environment
#
# DATABASE_URL is the one that matters. Without it there is nowhere to keep a
# workspace, so the application starts and every screen renders its empty
# state — there is no account to sign in to and nothing to show. It used to
# serve a seeded workspace instead, which is why a real account could be
# shown another company's projects: the same fallback fired whenever a query
# came back empty, not only when the database was absent.
#
# Everything below it is optional. Each inference capability uses its vendor
# when that vendor's key is present and a deterministic mock when it is not,
# and /api/providers reports which resolved to which.
# ---------------------------------------------------------------------------

# This deployment's own origin.
#
# Used for canonical URLs, the sitemap, OG metadata — and, less obviously,
# for the redirect the identity provider sends a browser back to and for the
# CSRF origin check on every write. Those last two are why this file ships
# pointing at localhost: with a production domain in it, a local `npm run
# dev` sends anybody who presses "Continue with Google" to demoriff.com, and
# nobody can sign in to their own machine at all.
#
# Set it to the real origin on a real deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# How vendors are chosen. Leave this unset (or "auto") and each capability
# below uses its vendor when that vendor's key is present and a deterministic
# mock when it is not — so one key buys one real capability, not none.
#
#   auto  every key you have is used; the rest are mocked  (default)
#   live  refuses to start unless every key is set         (production)
#   mock  ignores every key                                (demos, tests)
#
# /api/providers reports what each capability resolved to, and the Studio
# says so on screen when a transcript came from the mock.
DEMORIFF_PROVIDERS=auto

# --- Inference vendors -----------------------------------------------------
# Each line enables one capability on its own:
#   DEEPGRAM_API_KEY      transcription — the one the editor is built on
#   ELEVENLABS_API_KEY    synthesis (also needs DEMORIFF_WORKSPACE_ID)
#   ANTHROPIC_API_KEY     translation, and masking over frame contents
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# --- Inbound webhook verification -----------------------------------------
# When set, POST /api/webhooks requires a valid DemoRiff-Signature header.
DEMORIFF_WEBHOOK_SECRET=
# Webhook destinations must be https and must not resolve to a private
# address. Set this to "yes" to deliver to http and to loopback while
# developing against a local receiver. Never set it in production: it removes
# the only thing stopping a customer-supplied URL from aiming the worker at
# the instance metadata service.
DEMORIFF_ALLOW_INSECURE_WEBHOOKS=

# --- Authentication (WorkOS AuthKit) ---------------------------------------
# Both are required. Without them a production deployment cannot sign anybody
# in, which is deliberate: there is no other way in, and the development
# email path is refused there.
#
# One integration covers all of it — Google, Microsoft, passwords and magic
# links through AuthKit's hosted pane, and enterprise SAML through an
# organization. Configure which of those are on in the WorkOS dashboard; this
# application asks for whichever button was pressed.
#
# The redirect URI to register with WorkOS is:
#   <NEXT_PUBLIC_SITE_URL>/api/auth/authkit/callback
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Signs the OAuth `state` parameter. Required in production — falling back to
# a constant would mean every deployment shares a signing key.
DEMORIFF_SSO_STATE_SECRET=
# Signs session cookies, and stands in for the line above when that is unset.
# Required in production for the same reason: a shared development constant
# is the same as having no signing key at all. Generate with
# `openssl rand -hex 32`.
DEMORIFF_SESSION_SECRET=
# Extra origins accepted on state-changing requests, comma separated. The
# site's own origin (NEXT_PUBLIC_SITE_URL) is always trusted; this is for a
# tunnel or a second hostname in front of the same deployment. Every origin
# listed here can post to this application as a signed-in person's browser.
DEMORIFF_TRUSTED_ORIGINS=
# Development only. Set this and the mock identity provider asserts an
# enterprise login against that organization, so the SSO path can be walked
# without a vendor. Leave it unset and every mock sign-in is self-serve,
# which is the path that creates a workspace.
DEMORIFF_SSO_MOCK_ORGANIZATION=
STRIPE_SECRET_KEY=
# Verifies the Stripe webhook at POST /api/billing/stripe — the only path
# that writes a workspace's plan. Without it every delivery is refused,
# which is the right failure: a plan set from an unverified request is a
# plan anybody can set.
STRIPE_WEBHOOK_SECRET=
# Price ids, per plan. Environment rather than hardcoded, because the same
# code runs against test-mode and live-mode prices with different ids.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_SCALE=

# --- Database ---------------------------------------------------------------
# Postgres connection string, and the one variable you have to get right.
# Without it there is no workspace to be in: the application still starts and
# every screen renders the empty state that says so. It does not fall back to
# sample data — nothing that renders can reach any.
#
# This line has no password in it, which works against a Postgres set up for
# trust authentication on localhost and fails against one that wants a
# password — the common case on a Debian or Ubuntu install. If it does, add
# the role's password:
#
#   DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/demoriff
#
# `npm run db:migrate` checks the connection before it starts and tells you
# which of those it hit.
DATABASE_URL=postgres://postgres@localhost:5432/demoriff
DATABASE_POOL_MAX=10

# --- Storage (Phase 6) -----------------------------------------------------
# "local" (default) writes to disk; "s3" requires the optional AWS SDK.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.storage
# Signed read URLs are forgeable without this. Required in production.
STORAGE_SIGNING_SECRET=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# --- Jobs (Phase 6) --------------------------------------------------------
# Set alongside DATABASE_URL to route renders through the durable queue
# instead of the in-memory mock.
DEMORIFF_WORKSPACE_ID=

# --- Render worker (Phase 6) -----------------------------------------------
# `npm run worker` claims render jobs and encodes them. Requires ffmpeg and
# ffprobe on PATH and DATABASE_URL set.
RENDER_WORKER_ID=
RENDER_WORKER_POLL_MS=2000

# --- Analytics -------------------------------------------------------------
# Signs the personalized links a salesperson sends, which identify a viewer
# to the analytics store. Without it those links are forgeable, and anybody
# who works out the format can attribute a view to any contact they like.
# Generate with `openssl rand -hex 32`.
DEMORIFF_LINK_SECRET=

# --- The Riff Agent --------------------------------------------------------
# Where to find a Chromium for the agent's isolated browser sessions. Only
# needed when the bundled resolution does not find one — a container image
# without a browser, or a build that installs it somewhere unusual.
CHROMIUM_PATH=

# --- Secrets at rest (Phase 8) ---------------------------------------------
# Seals credentials this product is *given* rather than issues — today, the
# token for a customer's SIEM collector. Required in production: a shared
# development constant would let every deployment read every other one's.
DEMORIFF_SECRET_KEY=

# --- Audit streaming (Phase 8) ---------------------------------------------
# How often `npm run worker` ships new audit entries to registered SIEM
# destinations. Destinations themselves are registered per workspace through
# POST /api/siem.
AUDIT_STREAM_INTERVAL_MS=30000
