# ---------------------------------------------------------------------------
# DemoRiff — environment
#
# To run this locally you need ONE of the variables in this file:
# DATABASE_URL. It is the first one below, and everything after the "optional"
# banner can stay exactly as it ships.
#
# The file is long because it also documents production, S3, Stripe and three
# inference vendors. None of that is needed to sign in, record, render,
# publish and read analytics on your own machine — each vendor falls back to a
# deterministic mock, and /api/providers reports which resolved to which.
# ---------------------------------------------------------------------------

# --- Database: the one you have to set -------------------------------------
# Postgres connection string. Without it there is no workspace to be in: the
# application still starts and every screen renders the empty state that says
# so. It does not fall back to sample data — nothing that renders can reach
# any. That fallback is what used to show a brand-new account another
# company's projects, and it is gone.
#
# This line has no password in it, which works against a Postgres set up for
# trust authentication on localhost and fails against one that wants a
# password — the common case on a Debian or Ubuntu install. If it does, add
# the role's password:
#
#   DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/demoriff
#
# `npm run db:migrate` checks the connection before it starts and tells you
# which of those it hit.
DATABASE_URL=postgres://postgres@localhost:5432/demoriff

# --- This deployment's own origin ------------------------------------------
# Correct as it ships for local development; change it only when you deploy.
#
# Used for canonical URLs, the sitemap, OG metadata — and, less obviously, for
# the redirect the identity provider sends a browser back to and for the CSRF
# origin check on every write. Those last two are why this file points at
# localhost: with a production domain in it, a local `npm run dev` sends
# anybody who presses "Continue with Google" to demoriff.com, and nobody can
# sign in to their own machine at all.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================================================
# Everything below this line is optional.
#
# Leave the rest of the file untouched and the application runs: a
# development identity provider stands in for WorkOS, each inference
# capability uses a deterministic mock, renders go through the durable queue
# to local disk, and billing is inert.
# ===========================================================================

# --- Inference vendors -----------------------------------------------------
# Each key enables one capability on its own — one key buys one real
# capability, not none — and the Studio says on screen when a transcript came
# from the mock.
#
#   DEEPGRAM_API_KEY      transcription — the one the editor is built on
#   ANTHROPIC_API_KEY     translation, and masking over frame contents
#   ELEVENLABS_API_KEY    synthesis; needs DEMORIFF_WORKSPACE_ID beside it,
#                         because a cloned voice is scoped to one workspace
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
DEMORIFF_WORKSPACE_ID=

# How vendors are chosen:
#
#   auto  every key you have is used; the rest are mocked  (default)
#   live  refuses to start unless every key is set         (production)
#   mock  ignores every key                                (demos, tests)
DEMORIFF_PROVIDERS=auto

# --- Required in production, ignored here ----------------------------------
# A production deployment refuses to start, or refuses to sign anybody in,
# without these. In development each one falls back, which is why you can
# leave them all blank.
#
# WorkOS AuthKit covers Google, Microsoft, passwords and magic links through
# its hosted pane, and enterprise SAML through an organization. Without it a
# production deployment cannot sign anybody in, which is deliberate: there is
# no other way in, and the development email path is refused there.
#
# The redirect URI to register with WorkOS is:
#   <NEXT_PUBLIC_SITE_URL>/api/auth/authkit/callback
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# The four secrets below are each `openssl rand -hex 32`. They are separate
# because they sign different things, and a deployment that shares one key
# across all of them has a single compromise that forges all four.
#
#   DEMORIFF_SESSION_SECRET   session cookies
#   DEMORIFF_SSO_STATE_SECRET the OAuth `state` parameter; falls back to the
#                             line above when unset
#   STORAGE_SIGNING_SECRET    signed read URLs, which are forgeable without it
#   DEMORIFF_LINK_SECRET      the personalized links a salesperson sends.
#                             Without it anybody who works out the format can
#                             attribute a view to any contact they like.
#   DEMORIFF_SECRET_KEY       seals credentials this product is *given* rather
#                             than issues — today, a customer's SIEM token
DEMORIFF_SESSION_SECRET=
DEMORIFF_SSO_STATE_SECRET=
STORAGE_SIGNING_SECRET=
DEMORIFF_LINK_SECRET=
DEMORIFF_SECRET_KEY=

# --- Storage: local disk unless you say otherwise --------------------------
# "local" writes under STORAGE_LOCAL_ROOT; "s3" requires the optional AWS SDK
# and at least S3_BUCKET and S3_REGION.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# --- Billing ---------------------------------------------------------------
# Only needed to charge anybody. Without STRIPE_WEBHOOK_SECRET every delivery
# to POST /api/billing/stripe is refused, which is the right failure: that is
# the only path that writes a workspace's plan, and a plan set from an
# unverified request is a plan anybody can set.
#
# Price ids live here rather than in code because the same code runs against
# test-mode and live-mode prices with different ids.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_SCALE=

# --- Outbound and inbound webhooks -----------------------------------------
# When set, POST /api/webhooks requires a valid DemoRiff-Signature header.
DEMORIFF_WEBHOOK_SECRET=
# Webhook destinations must be https and must not resolve to a private
# address. Set this to "yes" to deliver to http and to loopback while
# developing against a local receiver. Never set it in production: it removes
# the only thing stopping a customer-supplied URL from aiming the worker at
# the instance metadata service.
DEMORIFF_ALLOW_INSECURE_WEBHOOKS=

# --- Render worker ---------------------------------------------------------
# `npm run worker` claims render jobs and encodes them. It needs ffmpeg and
# ffprobe on PATH and DATABASE_URL set — nothing here. The worker id defaults
# to a random one per process, which is what you want unless you are pinning
# a worker in a deployment.
RENDER_WORKER_ID=
RENDER_WORKER_POLL_MS=2000
# How often the worker ships new audit entries to SIEM destinations, which
# are registered per workspace through POST /api/siem.
AUDIT_STREAM_INTERVAL_MS=30000

# --- Odds and ends ---------------------------------------------------------
# Extra origins accepted on state-changing requests, comma separated. The
# site's own origin is always trusted; this is for a tunnel or a second
# hostname in front of the same deployment. Every origin listed here can post
# to this application as a signed-in person's browser.
DEMORIFF_TRUSTED_ORIGINS=
# Development only. Set this and the mock identity provider asserts an
# enterprise login against that organization, so the SSO path can be walked
# without a vendor. Leave it unset and every mock sign-in is self-serve,
# which is the path that creates a workspace.
DEMORIFF_SSO_MOCK_ORGANIZATION=
# Postgres connection pool size.
DATABASE_POOL_MAX=10

# --- Tests -----------------------------------------------------------------
# Which Chromium the end-to-end suite launches. Nothing the application runs
# reads this — no code outside the tests ever starts a browser; the agent
# takes one as an argument. `scripts/test-env.sh` finds a browser by itself
# and only needs this when it cannot.
CHROMIUM_PATH=
