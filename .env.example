# ---------------------------------------------------------------------------
# DemoRiff — environment
#
# The application runs with none of these set. Providers default to the
# deterministic mock set in lib/providers/mock.ts, which is what makes the
# whole platform explorable without credentials.
# ---------------------------------------------------------------------------

# Public site origin, used for canonical URLs, sitemap and OG metadata.
NEXT_PUBLIC_SITE_URL=https://demoriff.com

# "mock" (default) or "live". Live mode uses the vendor adapters in
# lib/providers — see lib/providers/README.md.
DEMORIFF_PROVIDERS=mock

# --- Inference vendors (only needed when DEMORIFF_PROVIDERS=live) ----------
# Live mode also requires DATABASE_URL and DEMORIFF_WORKSPACE_ID below: renders
# go through the durable queue, and synthesized audio is workspace-scoped.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=

# --- Render cluster --------------------------------------------------------
RENDER_CLUSTER_URL=
RENDER_CLUSTER_TOKEN=

# --- Inbound webhook verification -----------------------------------------
# When set, POST /api/webhooks requires a valid DemoRiff-Signature header.
DEMORIFF_WEBHOOK_SECRET=

# --- Storage and identity --------------------------------------------------
S3_BUCKET=
S3_REGION=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
STRIPE_SECRET_KEY=

# --- Database (Phase 6) ----------------------------------------------------
# Postgres connection string. Without it the app falls back to the seeded
# fixtures in lib/app-data.ts, so the UI still renders with no database.
DATABASE_URL=postgres://postgres@localhost:5432/demoriff
DATABASE_POOL_MAX=10

# --- Storage (Phase 6) -----------------------------------------------------
# "local" (default) writes to disk; "s3" requires the optional AWS SDK.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.storage
# Signed read URLs are forgeable without this. Required in production.
STORAGE_SIGNING_SECRET=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# --- Jobs (Phase 6) --------------------------------------------------------
# Set alongside DATABASE_URL to route renders through the durable queue
# instead of the in-memory mock.
DEMORIFF_WORKSPACE_ID=

# --- Render worker (Phase 6) -----------------------------------------------
# `npm run worker` claims render jobs and encodes them. Requires ffmpeg and
# ffprobe on PATH and DATABASE_URL set.
RENDER_WORKER_ID=
RENDER_WORKER_POLL_MS=2000
